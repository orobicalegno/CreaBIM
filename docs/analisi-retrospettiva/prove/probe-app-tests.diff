+/// Q10: import DXF lontano e vicino: dove finisce, in quale vista, si annulla?
+#[test]
+fn probe_q10_dxf_import() {
+    for (label, x0) in [("lontano", 500000.0), ("vicino", 1000.0)] {
+        let mut app = house();
+        let ctx = egui::Context::default();
+        let _ = &ctx;
+        let gf = app.doc.model().iter().find(|e| e.name == "Ground Floor plan").map(|e| e.id).unwrap();
+        let ff = app.doc.model().iter().find(|e| e.name == "First Floor plan").map(|e| e.id).unwrap();
+        app.active_view = Some(ff);
+        let path = std::env::temp_dir().join(format!("probe-{label}-{}.dxf", std::process::id()));
+        let text = format!("0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nLINE\n8\n0\n10\n{x0}\n20\n300000\n11\n{}\n21\n300000\n0\nENDSEC\n0\nEOF\n", x0 + 5000.0);
+        std::fs::write(&path, text).unwrap();
+        let before = snap(&app);
+        app.import_dxf(&path.to_string_lossy());
+        let added: Vec<_> = app.doc.model().iter().filter(|e| before.get(e.id).is_none()).map(|e| format!("{} {:?}", e.name, e.kind).chars().take(260).collect::<String>()).collect();
+        println!("DXF {label}: vista attiva prima First Floor; dopo={:?} (GF={:?}, FF={:?}); aggiunti {added:?}; stato: {}", app.active_view.and_then(|v| app.doc.model().get(v)).map(|e| e.name.clone()), gf, ff, app.status);
+        app.run_command(&ctx, crate::commands::Command::Undo, None);
+        println!("DXF {label}: dopo Annulla progetto identico a prima = {}", snap(&app) == before);
+        let _ = std::fs::remove_file(&path);
+    }
+}
