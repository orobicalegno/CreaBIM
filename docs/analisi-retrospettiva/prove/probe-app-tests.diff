+/// Q9: cambio di progetto (Ctrl+Tab / apertura) con uno spostamento dal
+/// vivo in corso nel progetto A, e nel progetto B uno spostamento
+/// confermato di un muro con lo stesso nome (es. una copia "Salva con nome").
+#[test]
+fn probe_q9_switch_project_during_live_move() {
+    let (mut app, ctx, mut t, _) = drawing_with(crate::planview::Tool::Select);
+    app.multi = true;
+    // progetto B: una copia della casa, con un muro spostato (passo "Move GF South")
+    let mut b = house();
+    let ctxb = egui::Context::default();
+    let _ = ctxb;
+    let wb = first(&b, |k| matches!(k, ElementKind::Wall(_)));
+    let ob = b.doc.model().get(wb).unwrap().clone();
+    let mut nb = ob.clone();
+    if let ElementKind::Wall(w) = &mut nb.kind { w.start.x += 0.5; w.end.x += 0.5; }
+    let label = format!("Move {}", ob.name);
+    b.doc.commit(creabim_core::Transaction::new(label.clone()).replace(ob, nb)).unwrap();
+    let b_doc = std::mem::replace(&mut b.doc, creabim_core::Document::default());
+    // A: Sposta dal vivo
+    let w = first(&app, |k| matches!(k, ElementKind::Wall(_)));
+    app.selection.only(w);
+    app.run_command(&ctx, crate::commands::Command::Move, None);
+    click_plan(&mut app, &ctx, &mut t, egui::Pos2::new(500.0, 400.0));
+    plan_frame(&mut app, &ctx, &mut t, vec![egui::Event::PointerMoved(egui::Pos2::new(530.0, 400.0))]);
+    println!("Q9: A modal={} passi A={:?}", app.plan.modal.is_some(), app.doc.undo_label());
+    // si apre / si passa al progetto B (stessi passi di load_model + documento con la sua cronologia)
+    app.keep_open();
+    app.doc = b_doc;
+    let b_steps = app.doc.undo_steps().len();
+    let b_label = app.doc.undo_label().map(str::to_owned);
+    println!("Q9: ora B: passi={b_steps} ultimo={b_label:?}; modal ancora attivo={}", app.plan.modal.is_some());
+    // il puntatore si muove, poi Esc
+    plan_frame(&mut app, &ctx, &mut t, vec![egui::Event::PointerMoved(egui::Pos2::new(540.0, 400.0))]);
+    let esc = egui::Event::Key { key: egui::Key::Escape, physical_key: None, pressed: true, repeat: false, modifiers: Default::default() };
+    plan_frame(&mut app, &ctx, &mut t, vec![esc]);
+    if let Some(mut m) = app.plan.modal.take() { m.discard(&mut app.doc); }
+    println!("Q9: B dopo: passi={} ultimo={:?} (prima {b_steps} {b_label:?}) redo={}", app.doc.undo_steps().len(), app.doc.undo_label(), app.doc.redo_steps().len());
+}
