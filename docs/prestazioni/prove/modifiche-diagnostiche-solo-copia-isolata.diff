diff --git a/crates/creabim-app/src/selection.rs b/crates/creabim-app/src/selection.rs
index f8e8daa..4f1183c 100644
--- a/crates/creabim-app/src/selection.rs
+++ b/crates/creabim-app/src/selection.rs
@@ -42,6 +42,16 @@ impl Selection {
     }
 
     pub fn contains(&self, id: ElementId) -> bool {
+        // DIAGNOSTICA (solo copia isolata): ricerca a costo costante
+        if std::env::var_os("DIAG_HASHSEL").is_some() && self.others.len() > 32 {
+            thread_local! { static C: std::cell::RefCell<(usize, usize, std::collections::HashSet<ElementId>)> = Default::default(); }
+            let key = (self.others.as_ptr() as usize, self.others.len());
+            return self.active == Some(id) || C.with(|c| {
+                let mut c = c.borrow_mut();
+                if (c.0, c.1) != key { *c = (key.0, key.1, self.others.iter().copied().collect()); }
+                c.2.contains(&id)
+            });
+        }
         self.active == Some(id) || self.others.contains(&id)
     }
 
